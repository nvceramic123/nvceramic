  "blogs": [
    {
      "id": "BLOG-001",
      "title": "600x1200 GVT Tiles: Where Should You Use Them?",
      "category": "Tile Buying Guide",
      "slug": "600x1200-gvt-tiles-where-to-use",
      "shortDescription": "A practical guide to choosing 600x1200 GVT tiles for homes, hotels and commercial spaces.",
      "image": "",
      "content": "600x1200 mm GVT tiles are a popular large-format choice for modern interiors because they create fewer visible joints and can give a clean, spacious appearance.\n\nWhere do they work well? Living rooms, bedrooms, villas, hotel interiors and many commercial spaces are common applications. The right finish, surface suitability and product specification should always be checked for the intended area.\n\nBefore buying, confirm the exact size, finish, quantity, batch availability and installation requirements. For project work, also check the substrate, adhesive, grout and movement-joint requirements with the installer.\n\nFor help selecting a suitable format or finish, share your application and approximate quantity with N V CERAMIC.",
      "relatedProductIds": [
        "PRD-001"
      ],
      "seoTitle": "600x1200 GVT Tiles: Where to Use Them | N V CERAMIC",
      "metaDescription": "Learn where 600x1200 GVT tiles work best and what to consider before selecting them for residential and project spaces.",
      "author": "N V CERAMIC",
      "publishedDate": "2026-10-07",
      "status": "published",
      "featured": true
    },
    {
      "id": "BLOG-002",
      "title": "Glossy vs Matt Tiles: Which Finish Is Right for Your Space?",
      "category": "Tile Buying Guide",
      "slug": "glossy-vs-matt-tiles",
      "shortDescription": "Understand the practical differences between glossy and matt tile finishes before buying.",
      "image": "",
      "content": "Glossy and matt tile finishes can create very different visual and practical results. Glossy surfaces can reflect more light and are often easy to wipe clean, while matt finishes create a softer look and can reduce visible glare.\n\nFor living rooms and feature areas, the choice is often mainly about appearance and maintenance. For bathrooms, balconies, parking and other areas where slip resistance matters, choose according to the product's technical specification rather than appearance alone.\n\nAlso consider lighting, cleaning expectations, traffic, water exposure and the overall design of the space.\n\nTell N V CERAMIC your room or project application, preferred look and size to get help narrowing down the right options.",
      "relatedProductIds": [],
      "seoTitle": "Glossy vs Matt Tiles: Which Finish Is Better?",
